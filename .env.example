# 慢慢来 · CookClip 本地配置模板
# 复制为仓库根目录的 .env：cp .env.example .env
# 前端（Node）与后端（FastAPI）都从这里读取，各自忽略无关项。
# 不复制也能跑，但对话模型的密钥（MODEL_API_KEY 或 OPENROUTER_API_KEY）必须填写后才能对话。

# ---------- 前端 frontend/server.cjs ----------

# OpenRouter 密钥，默认免费模型必填；勿提交密钥
OPENROUTER_API_KEY=replace_locally

# 对话模型接口，OpenAI 兼容即可。默认使用 OpenRouter 免费模型；
# 切换到 DeepSeek 官方 API 的步骤见 README「切换到 DeepSeek」一节，即改成：
#   MODEL_API_BASE=https://api.deepseek.com/v1
#   MODEL_API_KEY=sk-你的 DeepSeek 密钥
#   MODEL_NAME=deepseek-chat（推理模型用 deepseek-reasoner）
MODEL_API_BASE=https://openrouter.ai/api/v1
MODEL_API_KEY=
MODEL_NAME=inclusionai/ling-3.0-flash-sante:free

# 步骤检查时用户传的照片要不要一起发给模型。默认发（DeepSeek 的 deepseek-chat
# 实测能正确描述画面）。换成看不了图的模型时（带了图会返回 400）设成 false，
# 页面就会如实说明「照片只留给你自己对照」。
MODEL_VISION_ENABLED=true
# 想用另一个模型专门看图时填这里；留空表示就用 MODEL_NAME 本身
MODEL_VISION_NAME=

# FastAPI 后端地址，用于 YouTube 实时检索
VIDEO_BACKEND_URL=http://127.0.0.1:8000

# 前端监听端口（可选）
PORT=8766

# 前端监听地址（可选）。默认只绑 127.0.0.1，只有本机能打开。
# 想在手机上把页面加到主屏幕当 App 用（PWA），就设成 0.0.0.0，
# 启动时会把局域网地址打印出来，手机连同一个 WiFi 打开即可。
# 注意：这个 demo 没有登录，开到局域网 = 同一 WiFi 的人都能用你的后端和模型密钥。
# 演示时建议用手机开热点、只让自己电脑连，比场馆公共 WiFi 安全；用完记得改回来。
# HOST=0.0.0.0

# ---------- 后端 backend/app/config.py ----------

APP_NAME=CookClip

# SQLite 数据库（相对 backend/ 目录）
DATABASE_URL=sqlite:///./data/cookclip.db

# 本地视频素材库
LOCAL_STORAGE_ROOT=./data/storage

# 下载临时目录
TEMP_ROOT=/tmp/cookclip

# ffmpeg 位置（yt-dlp 合并音视频、以及步骤分解的画面切点检测都要用，缺了会报
# "ffmpeg is not installed"，步骤也只能退化成通用骨架）。留空则自动在 PATH 里找；
# Windows 上装完记得填成 bin 目录，例如：
#   FFMPEG_LOCATION=C:/Users/you/.workbuddy/binaries/ffmpeg/bin
FFMPEG_LOCATION=

# 并发下载数量
LOCAL_WORKERS=2

# 允许提交的平台域名（逗号分隔）
ALLOWED_VIDEO_DOMAINS=youtube.com,youtu.be,bilibili.com,b23.tv,tiktok.com,instagram.com

# 单条视频上限
MAX_VIDEO_DURATION_SECONDS=3600
MAX_FILE_SIZE_BYTES=2147483648

# ---------- 速度调优（可选，都有合理默认值） ----------

# 下载清晰度上限。步骤卡片只用到 640px 宽的截图，1080p 的像素基本都被丢掉，
# 但视频页要给人看，所以默认 720p 折中。现场想更快调到 480，想更清楚调到 1080。
# MAX_VIDEO_HEIGHT=720

# yt-dlp 的分片并发数。YouTube 是整段 https 下载，收益不如 HLS 明显，
# 但长视频上能看到可见提速；设 1 就是原来的单连接行为。
# DOWNLOAD_CONCURRENCY=4

# 场景检测只解码 I 帧（实测快约 6.6 倍：146 秒的 1080p 从 9.5 秒降到 1.4 秒）。
# 想拿到与全解码完全一致的切点就设 false。
# FAST_SCENE_DETECT=true

# 逐段问模型时的并发数。串行会等到天荒地老；但调太高容易被限流，
# 超时的那一段会退回「只有截图」。
# CAPTION_CONCURRENCY=6

# YouTube 检索
# 整个检索子进程的总预算（秒）。8 秒太紧：光 Python 启动 + import yt-dlp 就要 1~2 秒
SEARCH_TIMEOUT_SECONDS=25
# 单次 socket 操作超时（秒），比总预算小，连不上时能早点失败并给出真实原因
SEARCH_SOCKET_TIMEOUT_SECONDS=10
SEARCH_FETCH_LIMIT=20
SEARCH_RESULT_LIMIT=12
SEARCH_CACHE_TTL_SECONDS=21600
SEARCH_EMPTY_CACHE_TTL_SECONDS=3600
SEARCH_MAX_CONCURRENT=1

# 可选的 Netscape 格式 cookie 文件路径，用于访问登录受限内容
# YT_DLP_COOKIE_FILE=

# Optional: explicitly authorize local Chrome login access for YouTube downloads.
# YT_DLP_COOKIE_BROWSER=chrome
